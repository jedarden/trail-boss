#!/bin/bash
# Trail Boss CLI — navigation commands for tmux integration
set -e

TB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DAEMON_URL="${TRAILBOSS_URL:-http://127.0.0.1:4000}"

case "$1" in
  jump-next)
    # Query daemon for head-of-queue pane id, then navigate to it
    PANE_INFO=$(curl -s "$DAEMON_URL/next")
    PANE_ID=$(echo "$PANE_INFO" | grep -o '"paneId":"[^"]*"' | cut -d'"' -f4)

    if [ -z "$PANE_ID" ] || [ "$PANE_ID" = "null" ]; then
      REASON=$(echo "$PANE_INFO" | grep -o '"reason":"[^"]*"' | cut -d'"' -f4)
      echo "Trail Boss: $REASON" >&2
      exit 1
    fi

    # Navigate to the pane: switch-client, select-window, select-pane
    # Pane ids are tmux-server-global, so we can address them directly
    SESSION_NAME=$(tmux display -p -t "$PANE_ID" '#{session_name}')
    if [ -z "$SESSION_NAME" ]; then
      echo "Trail Boss: pane $PANE_ID not found" >&2
      exit 1
    fi

    # Record origin so `trailboss return` can come back
    tmux display -p '#{session_name}' > /tmp/trailboss-origin
    tmux switch-client -t "$SESSION_NAME" \; select-window -t "$PANE_ID" \; select-pane -t "$PANE_ID"
    ;;

  skip)
    # Skip current head and move to tail, then jump to new head
    PANE_INFO=$(curl -s -X POST "$DAEMON_URL/skip")
    PANE_ID=$(echo "$PANE_INFO" | grep -o '"paneId":"[^"]*"' | cut -d'"' -f4)

    if [ -z "$PANE_ID" ] || [ "$PANE_ID" = "null" ]; then
      REASON=$(echo "$PANE_INFO" | grep -o '"reason":"[^"]*"' | cut -d'"' -f4)
      echo "Trail Boss: $REASON" >&2
      exit 1
    fi

    SESSION_NAME=$(tmux display -p -t "$PANE_ID" '#{session_name}')
    if [ -z "$SESSION_NAME" ]; then
      echo "Trail Boss: pane $PANE_ID not found" >&2
      exit 1
    fi

    tmux display -p '#{session_name}' > /tmp/trailboss-origin
    tmux switch-client -t "$SESSION_NAME" \; select-window -t "$PANE_ID" \; select-pane -t "$PANE_ID"
    ;;

  popup)
    # Show the queue picker overlay
    exec "$TB_DIR/bin/trailboss-popup"
    ;;

  return)
    # Always return to the Trail Boss dashboard window (TUI pane is active)
    tmux switch-client -t trail-boss:dashboard
    ;;

  doctor)
    # Healthcheck for Trail Boss installation and runtime state
    FAILED=0

    echo "Trail Boss Doctor"
    echo "=================="
    echo

    # 1. Daemon reachable
    echo -n "✓ Daemon reachable: "
    if curl -s --max-time 2 "$DAEMON_URL/status" >/dev/null 2>&1; then
      echo "OK"
    else
      echo "FAIL"
      echo "  → Daemon not responding at $DAEMON_URL"
      echo "  → Fix: Run 'bin/trailboss-start' or 'systemctl --user start trailboss-daemon'"
      FAILED=1
    fi

    # 2. Daemon process/service healthy
    echo -n "✓ Daemon process healthy: "
    if systemctl --user is-active --quiet trailboss-daemon 2>/dev/null; then
      echo "OK (systemd)"
    elif tmux list-sessions 2>/dev/null | grep -q "^trail-boss:"; then
      # Check for daemon window in trail-boss session
      if tmux list-windows -t trail-boss 2>/dev/null | grep -q "daemon"; then
        echo "OK (tmux)"
      else
        echo "FAIL"
        echo "  → trail-boss tmux session exists but no daemon window found"
        echo "  → Fix: Run 'bin/trailboss-start'"
        FAILED=1
      fi
    else
      echo "FAIL"
      echo "  → No systemd service or trail-boss tmux session found"
      echo "  → Fix: Run 'bin/trailboss-start' or 'systemctl --user start trailboss-daemon'"
      FAILED=1
    fi

    # 3. trailboss-tui binary present
    echo -n "✓ trailboss-tui binary: "
    if [ -x "$TB_DIR/bin/trailboss-tui" ]; then
      echo "OK"
    else
      echo "FAIL"
      echo "  → Binary not found or not executable: $TB_DIR/bin/trailboss-tui"
      echo "  → Fix: Build the TUI with 'cd tui && go build -o ../bin/trailboss-tui'"
      FAILED=1
    fi

    # 4. Hooks wired
    echo -n "✓ Claude Code hooks wired: "
    SETTINGS_FILE="$HOME/.claude/settings.json"
    EMITTER_PATH="$TB_DIR/.claude/trailboss-emit.sh"

    if [ ! -f "$SETTINGS_FILE" ]; then
      echo "FAIL"
      echo "  → Claude settings file not found: $SETTINGS_FILE"
      echo "  → Fix: Ensure Claude Code is installed and has been run at least once"
      FAILED=1
    else
      MISSING_HOOKS=0
      for hook in Stop PermissionRequest UserPromptSubmit SessionStart SessionEnd; do
        if ! grep -q "\"$hook\"" "$SETTINGS_FILE" || \
           ! grep -A5 "\"$hook\"" "$SETTINGS_FILE" | grep -q "$EMITTER_PATH"; then
          MISSING_HOOKS=1
          break
        fi
      done

      if [ $MISSING_HOOKS -eq 0 ]; then
        echo "OK"
      else
        echo "FAIL"
        echo "  → Not all required hooks are pointing to $EMITTER_PATH"
        echo "  → Required hooks: Stop, PermissionRequest, UserPromptSubmit, SessionStart, SessionEnd"
        echo "  → Fix: Add hook entries to $SETTINGS_FILE for each event"
        FAILED=1
      fi
    fi

    # 5. tmux.conf keybindings loaded
    echo -n "✓ tmux keybindings loaded: "
    if [ -z "$TMUX" ]; then
      echo "SKIP (not in tmux)"
    else
      # Check if the keybindings are defined
      if tmux list-keys 2>/dev/null | grep -q "trailboss jump-next\|trailboss skip\|trailboss popup"; then
        echo "OK"
      else
        echo "FAIL"
        echo "  → Trail Boss keybindings not found in current tmux server"
        echo "  → Fix: Run 'tmux source-file $TB_DIR/tmux.conf' from within tmux"
        FAILED=1
      fi
    fi

    echo
    if [ $FAILED -eq 0 ]; then
      echo "All checks passed ✓"
      exit 0
    else
      echo "Some checks failed ✗"
      exit 1
    fi
    ;;

  *)
    echo "Usage: trailboss {jump-next|skip|popup|return|doctor}" >&2
    exit 1
    ;;
esac
