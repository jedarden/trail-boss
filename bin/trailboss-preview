#!/usr/bin/env bash
# Mirror the selected session in the lower dashboard pane.

TARGET_FILE="${TRAILBOSS_PREVIEW_TARGET_FILE:-/tmp/trailboss-preview-target}"

render_preview() {
    local target="" pane_h content_lines metadata label output visible
    IFS= read -r target 2>/dev/null < "$TARGET_FILE" || :

    pane_h=$(tmux display-message -p '#{pane_height}' 2>/dev/null) || pane_h=12
    [[ "$pane_h" =~ ^[0-9]+$ ]] || pane_h=12
    content_lines=$((pane_h - 1))
    (( content_lines > 0 )) || content_lines=1

    printf '\033[H\033[2J'
    if [[ -z "$target" ]]; then
        printf '\033[2m(no session selected — navigate in trail boss above)\033[0m\n'
        return
    fi
    if [[ ! "$target" =~ ^%[0-9]+$ ]]; then
        printf '\033[2m(preview target unavailable)\033[0m\n'
        return
    fi

    # A pane can disappear between display-message and capture-pane. Both
    # failures are expected when a selected session exits.
    if ! metadata=$(tmux display-message -p -t "$target" '#{pane_dead} #{session_name}:#{window_name}' 2>/dev/null); then
        printf '\033[2m(pane %s unavailable)\033[0m\n' "$target"
        return
    fi
    if [[ "$metadata" == "1 "* ]]; then
        printf '\033[2m(pane %s exited)\033[0m\n' "$target"
        return
    fi
    if [[ "$metadata" != "0 "* ]]; then
        printf '\033[2m(pane %s unavailable)\033[0m\n' "$target"
        return
    fi
    label="${metadata#0 }"
    [[ -n "$label" ]] || label="$target"

    if ! output=$(tmux capture-pane -p -e -t "$target" 2>/dev/null); then
        printf '\033[2m(pane %s unavailable)\033[0m\n' "$target"
        return
    fi
    visible=$(printf '%s\n' "$output" | tail -n "$content_lines")
    printf '\033[1;36m─── %s \033[0m\n' "$label"
    printf '%s\n' "$visible"
}

if [[ "${1:-}" == "--once" ]]; then
    render_preview
    exit 0
fi

while true; do
    render_preview
    sleep 0.5
done
