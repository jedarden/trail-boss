#!/usr/bin/env bash
# Trail Boss tmux adapter: watches panes for stuck-state detection
# Usage: trailboss-tmux-watch <pane-id> [<pane-id> ...]
#
# This script starts the tmux-level detector, which polls the specified panes
# and emits stuck/unstuck events to the daemon when output goes quiet at a prompt.
#
# Example:
#   trailboss-tmux-watch %446 %447

set -euo pipefail

# Colors for output
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly RED='\033[0;31m'
readonly NC='\033[0m' # No Color

# Trail Boss project root
readonly PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly DAEMON_URL="http://127.0.0.1:4000"

# Check if daemon is running
check_daemon() {
  if ! curl -sf "${DAEMON_URL}/status" > /dev/null 2>&1; then
    echo -e "${RED}Error: Trail Boss daemon is not running${NC}"
    echo "Start it with: trailboss-start"
    exit 1
  fi
}

# Validate pane IDs
validate_pane_ids() {
  local panes=("$@")
  local tmux_cmd=""

  # Support test environment
  if [[ -n "${TMUX_TEST_SOCK:-}" ]]; then
    tmux_cmd="tmux -S ${TMUX_TEST_SOCK}"
  else
    tmux_cmd="tmux"
  fi

  for pane_id in "${panes[@]}"; do
    # Check format: should be %number
    if [[ ! "$pane_id" =~ ^%[0-9]+$ ]]; then
      echo -e "${RED}Error: Invalid pane ID format: $pane_id${NC}"
      echo "Pane IDs must be in the format %NNN (e.g., %446)"
      exit 1
    fi

    # Check if pane exists
    if ! $tmux_cmd list-panes -F '#{pane_id}' | grep -q "^${pane_id}$"; then
      echo -e "${RED}Error: Pane does not exist: $pane_id${NC}"
      echo "Use 'tmux list-panes -a' to see available panes"
      exit 1
    fi
  done
}

# Get pane cwd
get_pane_cwd() {
  local pane_id="$1"
  local tmux_cmd=""

  if [[ -n "${TMUX_TEST_SOCK:-}" ]]; then
    tmux_cmd="tmux -S ${TMUX_TEST_SOCK}"
  else
    tmux_cmd="tmux"
  fi

  $tmux_cmd display -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null || echo ""
}

# Register a pane with the adapter
register_pane() {
  local pane_id="$1"
  local pane_cwd="$2"
  local pane_cwd_escaped="${pane_cwd//\"/\\\"}"

  curl -s -X POST "${DAEMON_URL}/event/normalized" \
    -H "Content-Type: application/json" \
    -d "{
      \"type\": \"registered\",
      \"sessionId\": \"tmux-${pane_id}\",
      \"paneId\": \"${pane_id}\",
      \"cwd\": \"${pane_cwd_escaped}\",
      \"transcriptPath\": \"\",
      \"timestamp\": $(date +%s)000
    }" > /dev/null

  echo -e "${GREEN}Registered: ${pane_id}${NC}"
}

# Main script
main() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: trailboss-tmux-watch <pane-id> [<pane-id> ...]"
    echo ""
    echo "Watches the specified tmux panes for stuck-state detection."
    echo "When a pane's output goes quiet at a prompt, a stuck event is emitted."
    echo ""
    echo "Example:"
    echo "  trailboss-tmux-watch %446 %447"
    echo ""
    echo "Options:"
    echo "  -h, --help    Show this help message"
    exit 0
  fi

  # Handle help flag
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    "$0" --help  # Call self with no args to show help
    exit 0
  fi

  check_daemon
  validate_pane_ids "$@"

  echo -e "${YELLOW}Starting Trail Boss tmux adapter...${NC}"
  echo "Watching panes: $*"
  echo ""

  # Register each pane
  local panes=("$@")
  for pane_id in "${panes[@]}"; do
    local pane_cwd
    pane_cwd="$(get_pane_cwd "$pane_id")"
    register_pane "$pane_id" "$pane_cwd"
  done

  echo ""
  echo "Starting tmux-level detector..."
  echo "Press Ctrl+C to stop"

  # Run the TypeScript adapter
  cd "$PROJECT_ROOT"
  exec bun run daemon/tmux-adapter.ts "$@"
}

main "$@"
