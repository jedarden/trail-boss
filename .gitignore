# Marathon: keep host-specific/internal config and runtime state local
.marathon/env
.marathon/logs/
.marathon/*-config/

# Beads: db is regenerable from issues.jsonl
.beads/*.db

# TUI build artifacts
tui/tui
bin/trailboss-tui

# Accidentally created tilde directory
~

# NEEDLE execution traces are local diagnostics.
**/.beads/traces/

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
